# DG Estética Automotiva: compressão e cache para aguentar muitos acessos
# (Hostinger usa LiteSpeed, que lê este arquivo como o Apache)

Options -Indexes
FileETag MTime Size

# ---------- tipos corretos ----------
<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType text/javascript .js
</IfModule>

# ---------- compressão do que é texto (vídeos e imagens já são comprimidos) ----------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/javascript application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/javascript application/javascript application/json image/svg+xml
</IfModule>

# ---------- cache ----------
# A página (HTML) sempre revalida, para que uma atualização apareça logo.
# CSS e JS: 1 dia. Imagens e vídeos: 30 dias. Fontes: 1 ano.
# Ao trocar um vídeo ou imagem por outro com o MESMO nome, renomeie o arquivo (ex.: film-2.mp4),
# senão quem já visitou continua vendo o antigo até o cache vencer.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpe?g|svg|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
